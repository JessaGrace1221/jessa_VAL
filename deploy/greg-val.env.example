# Greg Zlevor VAL deployment
# Railway service suggestion: greg-val

VAL_CLIENT_NAME=Greg Zlevor
VAL_CLIENT_SLUG=greg-val
VAL_CLIENT_BRAND_NAME=Greg VAL
VAL_PUBLIC_BASE_URL=https://greg-val-production.up.railway.app
VAL_DEFAULT_TIMEZONE=America/New_York
VAL_CLIENT_CONTEXT=This VAL supports Greg Zlevor, founder of Westwood International and HopeMakers. Prioritize relationship continuity, leadership commitments, Outlook email and calendar context, and clearly separate HopeMakers and Westwood International GHL pipeline/contact activity.

ADMIN_NAME=Greg Zlevor
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=owner
SESSION_SECRET=

DATABASE_URL=
OPENAI_KEY=
VAL_CHAT_MODEL=gpt-5.5

# Outlook / Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://greg-val-production.up.railway.app/auth/microsoft/callback

# Two named GHL accounts. VAL labels pipeline and calendar data with these names.
GHL_ACCOUNT_SLUGS=hopemakers,westwood

GHL_ACCOUNT_HOPEMAKERS_LABEL=HopeMakers
GHL_ACCOUNT_HOPEMAKERS_KEY=
GHL_ACCOUNT_HOPEMAKERS_LOC=
GHL_ACCOUNT_HOPEMAKERS_CALENDAR_IDS=

GHL_ACCOUNT_WESTWOOD_LABEL=Westwood International
GHL_ACCOUNT_WESTWOOD_KEY=
GHL_ACCOUNT_WESTWOOD_LOC=
GHL_ACCOUNT_WESTWOOD_CALENDAR_IDS=

# Optional if Greg also needs Google later. Leave blank for Outlook-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://greg-val-production.up.railway.app/auth/callback

OUTSCRAPER_API_KEY=
ROCKETREACH_API_KEY=
