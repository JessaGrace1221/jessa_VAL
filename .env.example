# VAL Core common environment template
# Copy these into each Railway service. Do not commit real secrets.

# Client identity
VAL_CLIENT_NAME=
VAL_CLIENT_SLUG=
VAL_CLIENT_BRAND_NAME=
VAL_PUBLIC_BASE_URL=
VAL_DEFAULT_TIMEZONE=America/New_York
VAL_SUPPORT_EMAIL=
VAL_CLIENT_CONTEXT=

# Admin login seeded on first startup
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=owner
SESSION_SECRET=
ENCRYPTION_KEY=

# Core services
DATABASE_URL=
OPENAI_KEY=
VAL_CHAT_MODEL=gpt-5.5
ANTHROPIC_KEY=
VAL_ALLOW_ANTHROPIC_FALLBACK=false

# GoHighLevel, use either the old or new names
GHL_KEY=
GHL_LOC=
# GHL_API_KEY=
# GHL_LOCATION_ID=
GHL_CALENDAR_ID=
GHL_CALENDAR_IDS=
GHL_OPPORTUNITY_PIPELINE_ID=
GHL_OPPORTUNITY_STAGE_ID=
GHL_OPPORTUNITY_PIPELINE_NAME=
GHL_OPPORTUNITY_STAGE_NAME=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Optional enrichment tools
OUTSCRAPER_API_KEY=
OUTSCRAPER_LINKEDIN_POSTS_URL=
OUTSCRAPER_GOOGLE_MAPS_SEARCH_URL=https://api.app.outscraper.com/maps/search-v3
ROCKETREACH_API_KEY=

# Optional ownership helpers
VAL_OWNER_EMAILS=
VAL_OWNER_EMAIL=
